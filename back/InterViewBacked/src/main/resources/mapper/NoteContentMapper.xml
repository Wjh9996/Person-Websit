<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wjh.interviewbacked.mapper.NoteContentMapper">

    <select id="selectContentByNoteId" resultType="java.lang.String">
        SELECT content FROM note_content WHERE note_id = #{noteId}
    </select>

    <insert id="insert" parameterType="NoteContent">
        INSERT INTO note_content (note_id, content) VALUES (#{noteId}, #{content})
    </insert>

    <update id="update" parameterType="NoteContent">
        UPDATE note_content SET content = #{content} WHERE note_id = #{noteId}
    </update>

    <delete id="deleteByNoteId">
        DELETE FROM note_content WHERE note_id = #{noteId}
    </delete>
</mapper>
