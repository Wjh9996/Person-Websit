server:
  port: 8080

spring:
  application:
    name: InterViewBacked
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    # 请改为你自己的数据库连接信息
    url: jdbc:mysql://localhost:3306/interview?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    # 推荐用环境变量注入，避免密码落盘；也可直接写明文（但切勿提交到仓库）
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:your_local_password}
  jackson:
    # LocalDateTime 由 Spring Boot 自带的 JavaTimeModule 序列化为 ISO-8601
    time-zone: GMT+8
    default-property-inclusion: non_null
  # 建表脚本使用 IF NOT EXISTS，always 为幂等，每次启动都会确保表存在
  # 注意：当前 schema.sql 是「DROP + CREATE」的开发重建脚本，
  # 生产环境必须改成 never，并由人工执行增量迁移（见 开发文档/4.数据库设计.md 第七章）
  sql:
    init:
      mode: never
      schema-locations: classpath:schema.sql

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.wjh.interviewbacked.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

app:
  cors:
    # 跨域白名单（多个用逗号分隔，支持端口通配符 http://localhost:*）
    # 注意：带凭证（Authorization）时绝不能整体配 *，必须写具体域名
    # 开发默认放开 localhost 任意端口（Vite 端口会漂移，写死会 403）；生产务必改成真实域名
    allowed-origins: ${APP_CORS_ORIGINS:http://localhost:*,http://127.0.0.1:*}

jwt:
  # 生产环境务必更换为足够长且随机的密钥（可用 openssl rand -base64 48 生成），建议环境变量注入
  secret: ${JWT_SECRET:please-change-me-to-a-long-random-string}
  # 令牌有效期（秒）：7 天
  expiration: 604800

llm:
  # 大模型连接（OpenAI 兼容协议，默认锁定 DeepSeek 国内厂商）
  # 真实密钥请用环境变量注入，切勿写入本文件提交到仓库
  base-url: ${LLM_BASE_URL:https://api.deepseek.com}
  api-key: ${LLM_API_KEY:}
  model: ${LLM_MODEL:deepseek-chat}
  timeout-seconds: 30
  max-tokens: 800
